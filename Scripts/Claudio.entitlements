<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The hardened runtime blocks the microphone unless the signature asks
	     for it: without this key, dictation is refused even with the
	     permission switched on in System Settings. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
