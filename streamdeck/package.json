{
	"name": "claudio-streamdeck",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Stream Deck plugin for Claudio.",
	"license": "MIT",
	"scripts": {
		"build": "rollup -c",
		"watch": "rollup -c -w",
		"test": "vitest run",
		"lint": "tsc --noEmit",
		"validate": "streamdeck validate com.okonoma.claudio.sdPlugin",
		"pack": "streamdeck pack com.okonoma.claudio.sdPlugin",
		"profile": "node scripts/make-profile.mjs"
	},
	"dependencies": {
		"@elgato/streamdeck": "^2.1.2",
		"ws": "^8.21.3"
	},
	"devDependencies": {
		"@elgato/cli": "^1.9.0",
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-typescript": "^12.3.0",
		"@types/node": "^20.19.0",
		"@types/ws": "^8.18.1",
		"jszip": "^3.10.2",
		"rollup": "^4.63.4",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11"
	}
}
